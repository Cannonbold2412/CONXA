      "session_keys": ["_app_session"]
    },
    "observation": {
      "final_url": "https://app.acme.com/login",
      "password_box": true,
      "otp_like": false,
      "markers": [{ "role": "button", "name": "Sign in" }],
      "responses": [{ "method": "GET", "path": "/api/me", "status": 401 }],
      "cookie_names": []
    },
    "expect": { "verdict": "no" }
  },
