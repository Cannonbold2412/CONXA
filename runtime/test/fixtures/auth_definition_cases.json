[
  {
    "name": "all three classes agree -> yes",
    "definition": {
      "version": 1,
      "probe_url": "https://app.acme.com/login",
      "signed_out": { "final_path": "/login", "markers": [{ "role": "button", "name": "Sign in" }], "password_box": true },
      "signed_in": { "final_path": "/home", "endpoints": [{ "method": "GET", "path": "/api/me", "ok": "2xx", "denied": "401" }] },
      "session_keys": ["_app_session"]
    },
    "observation": {
      "final_url": "https://app.acme.com/home",
      "password_box": false,
      "otp_like": false,
      "markers": [],
      "responses": [{ "method": "GET", "path": "/api/me", "status": 200 }],
      "cookie_names": ["_app_session", "csrf"]
    },
    "expect": { "verdict": "yes" }
  },
  {
    "name": "signed-out page evaluated against its own definition -> no (password box veto)",
    "definition": {
      "version": 1,
      "probe_url": "https://app.acme.com/login",
      "signed_out": { "final_path": "/login", "markers": [{ "role": "button", "name": "Sign in" }], "password_box": true },
