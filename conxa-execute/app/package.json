{
  "name": "conxa-execute",
  "version": "0.1.0",
  "description": "CONXA — run recorded skills without a third-party chat app",
  "main": "electron/main.js",
  "author": "Conxa",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config renderer/vite.config.mts",
    "dev:electron": "node electron/scripts/dev-electron.js",
    "build:renderer": "vite build --config renderer/vite.config.mts",
    "typecheck": "tsc --noEmit -p renderer/tsconfig.json",
    "test": "node --test electron/test/loop.test.js electron/test/classify.test.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "9.2.0",
    "electron": "^42.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "^3.22.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
