# Copy this file to .env and fill in the values below.
# Variables not listed here have sensible defaults in conxa_core/config.py.
#
# conxa-execute requires a Clerk sign-in to use the app at all — see
# docs/TRD.md §3.6 and app/auth.py. Local dev still needs none of this filled
# in to run the server: SKILL_AUTH_REQUIRED=false (the default) skips the
# boot-time checks below, the filesystem KV fallback covers the wallet/order
# stores with no database, and checkout routes will 500 with a clear message
# ("Cashfree credentials not configured") until you add real Cashfree keys.
# Signing in to the desktop app itself still needs a real Clerk app configured
# there (CONXA_EXECUTE_CLERK_DOMAIN/CLIENT_ID, see app/electron/auth_service.js).

# Dedicated LLM provider keys for the managed chat proxy (/v1/chat/completions).
# Kept separate from conxa-cloud's free-compile pool so a paid product never
# starves — or gets starved by — the free one. Same providers/env var shape as
# conxa-cloud/backend/.env.example — see that file for sign-up links and
# free-tier limits per provider. There is no *_ENABLED switch here (unlike
# conxa-cloud) — llm_config.py enables a provider purely by whether its
# *_API_KEYS is non-empty.
GROQ_API_KEYS=
GOOGLE_AI_STUDIO_API_KEYS=
NVIDIA_NIM_API_KEYS=

# Optional per-provider overrides (llm_config.py has working defaults for all
# three) — endpoint/text model rarely need changing; *_FALLBACK_TEXT_MODEL is
# the model llm_client.py retries once on that *same* provider's key before
# moving to the next provider, useful if your default model is rate-limited
# or deprecated. Uncomment only what you need to override, e.g.:
# GROQ_FALLBACK_TEXT_MODEL=llama-3.1-8b-instant
# GROQ_ENDPOINT=
# GROQ_TEXT_MODEL=

# ============================================================================
# Auth + Production (required when SKILL_AUTH_REQUIRED=true — see
# app/main.py::_validate_production_config)
# ============================================================================
SKILL_AUTH_REQUIRED=false

# Used to build the Cashfree return_url and shown to buyers as the /v1 base
# URL to paste into conxa-execute's Settings. Example: https://execute-api.conxa.in
SKILL_API_BASE_URL=

SKILL_DATABASE_URL=

# Cashfree billing — same merchant account as conxa-cloud
# (merchant.cashfree.com -> Developers -> API Keys), but its OWN webhook
# secret (register a webhook pointed at THIS service's /webhooks/cashfree
# and /webhooks/cashfree-orders, not conxa-cloud's). A configured secret is
# required — a webhook without a matching signature is rejected, not silently
# accepted.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=TEST

# Pre-create these 6 monthly recurring plans in the Cashfree Subscription
# Management dashboard — one-time packs need no plan IDs (Payment Links are
# created ad hoc). Prices: app/plans.py::PLAN_TIERS (packs: app/cashfree.py::TOKEN_TIERS).
CASHFREE_SUB_250K_PLAN_ID=
CASHFREE_SUB_500K_PLAN_ID=
CASHFREE_SUB_1M_PLAN_ID=
CASHFREE_SUB_2_5M_PLAN_ID=
CASHFREE_SUB_5M_PLAN_ID=
CASHFREE_SUB_10M_PLAN_ID=

# Internal bridge to conxa-cloud for Execute seat grants (docs/TRD.md §13.4c)
# — must match conxa-cloud's SKILL_EXECUTE_SERVICE_TOKEN exactly.
SKILL_EXECUTE_SERVICE_TOKEN=
SKILL_CONXA_CLOUD_API_BASE_URL=
