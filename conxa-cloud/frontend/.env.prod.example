# Conxa frontend — PRODUCTION (set as Vercel Production env vars, not committed)
# Prod lane: proxy targets the live backend and uses the PROD Clerk instance.

# Prod Clerk instance keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Live backend. No trailing slash.
API_ORIGIN=https://apis.conxa.in

# Must match SKILL_API_PROXY_SHARED_SECRET on the prod backend.
CONXA_API_PROXY_SECRET=
