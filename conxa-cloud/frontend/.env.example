NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
API_ORIGIN=
# Server-only shared secret used by this Next.js API proxy when calling the backend.
# Must match SKILL_API_PROXY_SHARED_SECRET on the backend.
CONXA_API_PROXY_SECRET=

# Same backend URL as API_ORIGIN, but readable from the browser (NEXT_PUBLIC_*).
# Used only by the "Report a bug" page, which uploads attachments straight to the
# backend to skip this proxy's request-size limit. No trailing slash.
NEXT_PUBLIC_API_ORIGIN=
