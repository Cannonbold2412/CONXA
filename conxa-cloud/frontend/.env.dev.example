# Conxa frontend — DEVELOPMENT (copy to .env.dev.local)
# Dev lane: points the Next.js /api/v1/* proxy at your local/dev backend and uses
# the DEV Clerk instance. Never point these at prod.

# Dev Clerk instance keys (separate from prod).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local backend by default; set to https://dev-apis.conxa.in for a hosted dev tier.
# No trailing slash.
API_ORIGIN=http://127.0.0.1:8000

# Must match SKILL_API_PROXY_SHARED_SECRET on the dev backend.
CONXA_API_PROXY_SECRET=
